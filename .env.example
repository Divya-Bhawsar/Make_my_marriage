# Make My Marriage — Environment Configuration Template
# Copy this file to .env.local for local development.
# Do NOT commit .env or .env.local to source control.

# ==============================================================================
# Essential Scaffold & Application Configuration
# ==============================================================================
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas connection string (or local MongoDB for development)
DATABASE_URL=mongodb://localhost:27017/make_my_marriage

# Session Secret (used to HMAC/hash session tokens and rate-limit keys)
# Must be at least 32 characters long in production
SESSION_SECRET=local-development-session-secret-must-be-at-least-32-chars-long

# ==============================================================================
# Deferred Third-Party Integrations (Configure when implementing future phases)
# ==============================================================================

# Resend Email Delivery (Phase 3: Invitations & Reminders)
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=Make My Marriage <invitations@makemymarriage.com>

# Google Places API (Phase 4: Vendor Discovery)
# GOOGLE_PLACES_API_KEY=AIzaSy...

# Cloudflare R2 Media Storage (Phase 6: Photo Gallery & Covers)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=make-my-marriage-media

# Vercel Cron Secret (Phase 3: Background Email Worker Protection)
# CRON_SECRET=your-secure-cron-secret
